---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Analytics from '@vercel/analytics/astro';
import "../styles/globals.css";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Alfacredit, S.A. ofrece microcréditos rápidos y personalizados para pequeños, medianos negocios y comerciantes en Nicaragua. Procesos ágiles, transparencia total y acompañamiento personalizado. ¡Solicita tu crédito hoy!">
		<meta property="og:title" content="Alfacredit, S.A. | Créditos Rápidos y Personalizados en Nicaragua">
		<meta property="og:description" content="Ofrecemos microcréditos rápidos y soluciones de financiamiento para pequeños, medianos negocios y comerciantes en Nicaragua con atención personalizada y procesos ágiles.">
		<meta property="og:image" content="https://alfacreditsa.com/alfacredit-sa-social.webp">
		<meta property="og:url" content="https://alfacreditsa.com/">
		<meta property="og:type" content="website">

		<title>Alfacredit, S.A. | Créditos Rápidos para pequeños, medianos negocios y Comerciantes en Nicaragua</title>

		<!-- Prevención técnica de FOUC (Flash of Unstyled Content) -->
		<style is:inline>
			html:not(.ready) body {
				visibility: hidden;
				opacity: 0;
			}
			body {
				visibility: visible;
				opacity: 1;
				transition: opacity 0.15s ease-in;
			}
		</style>
		<script is:inline>
			function markReady() {
				document.documentElement.classList.add('ready');
			}
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', markReady);
			} else {
				markReady();
			}
			// Fallback de seguridad para garantizar visibilidad en cualquier circunstancia
			setTimeout(markReady, 1000);
		</script>
		<noscript>
			<style>
				html:not(.ready) body {
					visibility: visible !important;
					opacity: 1 !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<header class="relative">
			<Nav/>
		</header>  
		<main class="mt-[104px]">
			<slot/>
		</main>
		<Footer/>
		<Analytics />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
